+/* SPDX-License-Identifier: MIT */
+#ifndef LP_BLD_JIT_MEMORY_H
+#define LP_BLD_JIT_MEMORY_H
+
+#include <llvm/ExecutionEngine/SectionMemoryManager.h>
+#include <llvm/Support/ErrorHandling.h>
+#include <llvm/Support/Process.h>
+#include <llvm/Support/MathExtras.h>
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <limits>
+#include <memory>
+#include <vector>
+
+/* Keep each object's code, constants and unwind data within relocation range.
+ * SectionMemoryManager's independent mappings do not provide this guarantee.
+ */
+class LPContiguousMemoryManager final : public llvm::SectionMemoryManager {
+   struct Region {
+      llvm::sys::MemoryBlock memory;
+      uintptr_t used = 0;
+   };
+   struct Allocation {
+      llvm::sys::MemoryBlock memory;
+      std::array<Region, 3> regions;
+      bool finalized = false;
+   };
+   std::vector<std::unique_ptr<Allocation>> allocations;
+
+   uint8_t *allocate(unsigned region, uintptr_t size, unsigned alignment)
+   {
+      if (allocations.empty() || allocations.back()->finalized)
+         llvm::report_fatal_error("Gallivm JIT allocation without reservation");
+      Region &r = allocations.back()->regions[region];
+      uintptr_t base = reinterpret_cast<uintptr_t>(r.memory.base());
+      uintptr_t offset = llvm::alignTo(base + r.used, alignment ? alignment : 16) - base;
+      if (offset > r.memory.allocatedSize() ||
+          size > r.memory.allocatedSize() - offset)
+         llvm::report_fatal_error("Gallivm JIT section exceeds reservation");
+      r.used = offset + size;
+      return reinterpret_cast<uint8_t *>(base + offset);
+   }
+
+public:
+   ~LPContiguousMemoryManager() override
+   {
+      deregisterEHFrames();
+      for (auto &a : allocations) {
+         if (llvm::sys::Memory::releaseMappedMemory(a->memory))
+            llvm::report_fatal_error("Gallivm JIT could not release reserved memory");
+      }
+   }
+
+   bool needsToReserveAllocationSpace() override { return true; }
+
+   void reserveAllocationSpace(uintptr_t code_size, llvm::Align code_align,
+                               uintptr_t ro_size, llvm::Align ro_align,
+                               uintptr_t rw_size, llvm::Align rw_align) override
+   {
+      const uintptr_t page = llvm::sys::Process::getPageSizeEstimate();
+      const uintptr_t limit = std::numeric_limits<int32_t>::max();
+      const std::array<uintptr_t, 3> sizes = {code_size, ro_size, rw_size};
+      const std::array<uintptr_t, 3> aligns = {
+         code_align.value(), ro_align.value(), rw_align.value()
+      };
+      std::array<uintptr_t, 3> capacities;
+      uintptr_t total = 0;
+      for (unsigned i = 0; i < 3; ++i) {
+         uintptr_t padding = std::max<uintptr_t>(aligns[i], 16);
+         if (sizes[i] > limit || padding > limit - sizes[i])
+            llvm::report_fatal_error("Gallivm JIT object exceeds relocation range");
+         capacities[i] = llvm::alignTo(sizes[i] + padding, page);
+         if (capacities[i] > limit - total)
+            llvm::report_fatal_error("Gallivm JIT object exceeds relocation range");
+         total += capacities[i];
+      }
+      auto a = std::make_unique<Allocation>();
+      std::error_code error;
+      a->memory = llvm::sys::Memory::allocateMappedMemory(
+         total, nullptr, llvm::sys::Memory::MF_READ | llvm::sys::Memory::MF_WRITE, error);
+      if (error)
+         llvm::report_fatal_error("Gallivm JIT could not reserve contiguous memory");
+      auto *base = static_cast<uint8_t *>(a->memory.base());
+      for (unsigned i = 0; i < 3; ++i) {
+         a->regions[i].memory = llvm::sys::MemoryBlock(base, capacities[i]);
+         base += capacities[i];
+      }
+      allocations.push_back(std::move(a));
+   }
+
+   uint8_t *allocateCodeSection(uintptr_t size, unsigned alignment, unsigned,
+                                llvm::StringRef) override
+   {
+      return allocate(0, size, alignment);
+   }
+
+   uint8_t *allocateDataSection(uintptr_t size, unsigned alignment, unsigned,
+                                llvm::StringRef, bool read_only) override
+   {
+      return allocate(read_only ? 1 : 2, size, alignment);
+   }
+
+   bool finalizeMemory(std::string *message = nullptr) override
+   {
+      for (auto &a : allocations) {
+         if (a->finalized)
+            continue;
+         for (unsigned i = 0; i < 2; ++i) {
+            unsigned flags = llvm::sys::Memory::MF_READ;
+            if (i == 0)
+               flags |= llvm::sys::Memory::MF_EXEC;
+            std::error_code error =
+               llvm::sys::Memory::protectMappedMemory(a->regions[i].memory, flags);
+            if (error) {
+               if (message)
+                  *message = error.message();
+               return true;
+            }
+         }
+         llvm::sys::Memory::InvalidateInstructionCache(
+            a->regions[0].memory.base(), a->regions[0].used);
+         a->finalized = true;
+      }
+      return false;
+   }
+};
+
+#endif
