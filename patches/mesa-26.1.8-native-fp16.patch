+/* SPDX-License-Identifier: MIT */
+
+#include "nir_test.h"
+
+namespace {
+
+class nir_lower_fp16_cast_test : public nir_test {
+protected:
+   nir_lower_fp16_cast_test() : nir_test("nir_lower_fp16_cast_test") {}
+
+   bool lower(bool keep_undef)
+   {
+      unsigned flags = nir_lower_fp16_all | nir_lower_fp16_split_fp64;
+      if (keep_undef)
+         flags |= nir_lower_fp16_keep_undef;
+      return nir_lower_fp16_casts(
+         b->shader, static_cast<nir_lower_fp16_cast_options>(flags));
+   }
+
+   nir_alu_instr *consumer(nir_def *value)
+   {
+      return nir_def_as_alu(nir_u2u32(b, value));
+   }
+
+   void check_explicit(nir_op op, unsigned execution_mode)
+   {
+      b->shader->info.float_controls_execution_mode = execution_mode;
+      nir_def *value = nir_build_alu(b, op, nir_undef(b, 1, 32), NULL, NULL, NULL);
+      nir_alu_instr *use = consumer(value);
+      EXPECT_TRUE(lower(true));
+      EXPECT_NE(use->src[0].src.ssa, value);
+      nir_validate_shader(b->shader, "explicit fp16 rounding");
+   }
+};
+
+TEST_F(nir_lower_fp16_cast_test, default_all_lowers_unspecified)
+{
+   nir_def *value = nir_f2f16(b, nir_undef(b, 1, 32));
+   nir_alu_instr *use = consumer(value);
+   EXPECT_TRUE(lower(false));
+   EXPECT_NE(use->src[0].src.ssa, value);
+}
+
+TEST_F(nir_lower_fp16_cast_test, keep_unspecified)
+{
+   nir_def *value = nir_f2f16(b, nir_undef(b, 1, 32));
+   nir_alu_instr *use = consumer(value);
+   EXPECT_FALSE(lower(true));
+   EXPECT_EQ(use->src[0].src.ssa, value);
+}
+
+TEST_F(nir_lower_fp16_cast_test, keep_unspecified_intrinsic)
+{
+   nir_def *value = nir_convert_alu_types(
+      b, 16, nir_undef(b, 1, 32), nir_type_float32,
+      nir_type_float16, nir_rounding_mode_undef);
+   nir_alu_instr *use = consumer(value);
+   EXPECT_FALSE(lower(true));
+   EXPECT_EQ(use->src[0].src.ssa, value);
+}
+
+TEST_F(nir_lower_fp16_cast_test, explicit_rtne_opcode)
+{
+   check_explicit(nir_op_f2f16_rtne, 0);
+}
+
+TEST_F(nir_lower_fp16_cast_test, explicit_rtz_opcode)
+{
+   check_explicit(nir_op_f2f16_rtz, 0);
+}
+
+TEST_F(nir_lower_fp16_cast_test, shader_rtne)
+{
+   check_explicit(nir_op_f2f16, FLOAT_CONTROLS_ROUNDING_MODE_RTE_FP16);
+}
+
+TEST_F(nir_lower_fp16_cast_test, shader_rtz)
+{
+   check_explicit(nir_op_f2f16, FLOAT_CONTROLS_ROUNDING_MODE_RTZ_FP16);
+}
+
+TEST_F(nir_lower_fp16_cast_test, explicit_intrinsic_rounding)
+{
+   for (nir_rounding_mode mode : {nir_rounding_mode_rtne, nir_rounding_mode_rtz,
+                                 nir_rounding_mode_ru, nir_rounding_mode_rd}) {
+      nir_def *value = nir_convert_alu_types(
+         b, 16, nir_undef(b, 1, 32), nir_type_float32,
+         nir_type_float16, mode);
+      nir_alu_instr *use = consumer(value);
+      EXPECT_TRUE(lower(true));
+      EXPECT_NE(use->src[0].src.ssa, value);
+   }
+   nir_validate_shader(b->shader, "intrinsic fp16 rounding");
+}
+
+TEST_F(nir_lower_fp16_cast_test, still_splits_fp64_source)
+{
+   nir_def *value = nir_f2f16(b, nir_undef(b, 1, 64));
+   nir_alu_instr *use = consumer(value);
+   EXPECT_TRUE(lower(true));
+   EXPECT_EQ(use->src[0].src.ssa, value);
+   EXPECT_EQ(nir_def_as_alu(value)->src[0].src.ssa->bit_size, 32);
+   nir_validate_shader(b->shader, "split fp64 source");
+}
+
+TEST_F(nir_lower_fp16_cast_test, still_splits_fp64_destination)
+{
+   nir_def *value = nir_f2f64(b, nir_undef(b, 1, 16));
+   EXPECT_TRUE(lower(true));
+   EXPECT_EQ(nir_def_as_alu(value)->src[0].src.ssa->bit_size, 32);
+   nir_validate_shader(b->shader, "split fp64 destination");
+}
+
+}
