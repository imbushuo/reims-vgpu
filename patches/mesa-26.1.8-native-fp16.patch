Gallivm: retain native FP16 conversions with unspecified rounding

Avoid expanding generic f2f16 into branch-heavy integer arithmetic on CPUs
where Gallivm already supports native FP16 conversion. Explicit rounding
modes and targets without native support retain the existing lowering.
The new NIR option is opt-in; other drivers keep their current behavior.

Apply to the Mesa 26.1.8 source tree with patch -p1.

--- a/src/compiler/nir/nir.h
+++ b/src/compiler/nir/nir.h
@@ -6586,6 +6586,8 @@
    nir_lower_fp16_rd = (1 << 3),
    nir_lower_fp16_all = 0xf,
    nir_lower_fp16_split_fp64 = (1 << 4),
+   /* Leave conversions with no requested rounding mode to the backend. */
+   nir_lower_fp16_keep_undef = (1 << 5),
 } nir_lower_fp16_cast_options;
 bool nir_lower_fp16_casts(nir_shader *shader, nir_lower_fp16_cast_options options);
 bool nir_normalize_cubemap_coords(nir_shader *shader);
--- a/src/compiler/nir/nir_lower_fp16_conv.c
+++ b/src/compiler/nir/nir_lower_fp16_conv.c
@@ -308,7 +308,8 @@
       req_option = nir_lower_fp16_rd;
       break;
    case nir_rounding_mode_undef:
-      if ((options & nir_lower_fp16_all) == nir_lower_fp16_all) {
+      if ((options & nir_lower_fp16_all) == nir_lower_fp16_all &&
+          !(options & nir_lower_fp16_keep_undef)) {
          /* Pick one arbitrarily for lowering */
          mode = nir_rounding_mode_rtne;
          req_option = nir_lower_fp16_rtne;
